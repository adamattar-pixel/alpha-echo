DATABASE_URL=postgres://127.0.0.1:5432/alpha_echo
APP_HOST=127.0.0.1
APP_PORT=8088
RUST_LOG=alpha_echo=debug,tower_http=info
VITE_API_BASE_URL=http://127.0.0.1:8088

# Keep disabled until the local Codex CLI is authenticated and data use is understood.
CODEX_RESEARCH_ENABLED=false
CODEX_BINARY=codex
CODEX_RESEARCH_MODEL=gpt-5.6-sol
CODEX_RESEARCH_REASONING_EFFORT=medium
CODEX_RESEARCH_TIMEOUT_SECONDS=900
CODEX_RESEARCH_MAX_ATTEMPTS=2
